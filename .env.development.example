# Copy to .env.development. Keep credentials in the ignored copy only.
# Local execution loads this environment by default; set SIGLIP_ENV explicitly
# before startup to select any other .env.<name> file.

# Optional local data locations. Use absolute paths.
ACQ_DATA_ROOT=
ACQ_EVIDENCE_ROOT=

# Paired-review training project. Obtain these values from the training project's
# Supabase settings and the restricted acq_training reviewer account.
STUDIO_DATA_BACKEND=supabase
SUPABASE_PROJECT_REF=
STUDIO_DATABASE_URL=
STUDIO_WORKSPACE_ID=
STUDIO_STORAGE_SECRET=
STUDIO_CACHE_DIR=

# Optional historical MLS evidence recovery. Obtain the URL values from the
# approved read-only MLS source Supabase project and the provider credentials
# from the bounded Trestle development application. Recovery remains off below.
MLS_SOURCE_DATABASE_URL=
MLS_SOURCE_SUPABASE_URL=
TRESTLE_CLIENT_ID=
TRESTLE_CLIENT_SECRET=

# Hosted-review login. Use the HTTPS origin of the local secure reverse proxy,
# an operator email, a 14+ character password, and a 32+ character random secret.
STUDIO_PUBLIC_ORIGIN=
STUDIO_LOGIN_USERNAME=
STUDIO_LOGIN_PASSWORD=
STUDIO_SESSION_SECRET=
PORT=10000

# Keep intake/recovery, automatic labeling, model workers, and training paused.
STUDIO_ACQUISITION_RECOVERY_ENABLED=false
STUDIO_AUTOLABEL_PROVIDER=disabled
STUDIO_MODEL_WORKER=0
OPENAI_API_KEY=
