# Copy to .env. This file contains placeholders, never real credentials.
# Use absolute paths. Keep private data outside this repository.
# Existing users can point this at their current ACQVisionPilot directory.
ACQ_DATA_ROOT=
# Directory containing records.json, media.json, visual.json and media/
ACQ_EVIDENCE_ROOT=
# Optional: only required when explicitly running a paid GPT assessment.
OPENAI_API_KEY=

# Read-only Model Workbench challenge source. The database URL must identify the
# approved uxlfqsgynbbgspaakzey Supabase project. Every source transaction is
# forced read-only even if the supplied role has broader privileges.
MLS_SOURCE_SUPABASE_URL=https://uxlfqsgynbbgspaakzey.supabase.co
MLS_SOURCE_DATABASE_URL=
# Optional local shortcut to the existing MLSSourcing .env file.
MLS_SOURCING_ENV=
# Required only to retrieve and hash selected Cotality/Trestle photo bytes.
TRESTLE_CLIENT_ID=
TRESTLE_CLIENT_SECRET=

# Trusted single-principal Studio role (never read from a request body).
# Only operator/admin can explicitly freeze datasets or enqueue training.
STUDIO_ROLE=reviewer
STUDIO_REVIEWER_ID=

# Optional, default-off service-to-service ActVision v2 bridge.
# Use a distinct 32+ character secret, not the browser session/review token.
ACTVISION_SERVICE_TOKEN=
# Authorized MLS workspace identity; defaults to STUDIO_WORKSPACE_ID if unset.
ACTVISION_SOURCE_WORKSPACE_ID=
# Operator-provisioned local manifest, with relative hashed artifact paths.
# No trained v2 inference adapters are enabled by this rebuild.
ACTVISION_RELEASE_MANIFEST=

# Development-only paired-condition v1 service. Use a distinct 32+ character
# bearer token. These exact release identities prevent accidental promotion or
# substitution of a different package.
PAIRED_CONDITION_SERVICE_TOKEN=
PAIRED_CONDITION_SOURCE_WORKSPACE_ID=
PAIRED_CONDITION_MODE=development
PAIRED_CONDITION_RELEASE_ID=f9bac37b-3ac4-4b64-9b54-cd9581bd226a
PAIRED_CONDITION_MANIFEST_SHA256=3bcf16d679e032d8d7ac8520ca209ef6532c1b35472df8ca3ae5a29bedb2d273
